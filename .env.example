# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=portfolio_cms

# JWT signing secret (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_here

# GitHub Personal Access Token (repo scope, for committing content)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=sanrobin/sanrobin.github.io
GITHUB_BRANCH=main

# CORS — your live site URL
ALLOWED_ORIGIN=https://phoenixphan0.me

# Seed endpoint protection (any random secret, used once)
SEED_SECRET=any_random_string_here
